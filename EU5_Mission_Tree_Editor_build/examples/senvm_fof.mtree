    {
      "id": "senvm_fof_fra_normandy",
      "name": "La Normandie",
      "desc": "",
      "icon": "french_language_in_all_courts",
      "group": "group_1",
      "requires": [],
      "duration_days": 0,
      "final": false,
      "notes": "Areas: normandy_area. Ownable locations: 28. 1337 start: France owns 0, French subjects 27, others 1. Threshold 25 = +25 over start; weighted effort 25 (subject land x1, foreign land x2; target ~60).\n\nQuest system: evaluated when the mission is taken; a quest whose reward location is not owned drops out; at least half (rounded up) of the remaining quests must be true to take the mission.\nEach TRUE quest: (1) reward location goes up one rank - rural to town, town to city; never megalopolis except Paris; a city gets +5 dev instead. (2) its patron faction +5 disposition, fixed, positive only. (3) its patron faction gains influence in the reward location's province. (4) its bonus becomes an option in the choice event.\nChoice event on completion: one option per TRUE quest. The option gives its country modifier permanently AND spreads the patron faction's influence to half the provinces of that quest's area (rounded up, counting the reward province; most developed first; skips other factions' leader land), via senvm_fof_spread_apply. Disposition and influence apply only while the Fate of France situation is active and the patron faction still exists; the rank-up and the modifier always apply.\nEach TRUE quest also adds 1 to var:senvm_fof_mq_true (read by the final mission).",
      "manual_index": null,
      "blocks": {
        "visible": "",
        "enabled": "any_owned_location = {\n\tcount >= 25\n\tarea = area:normandy_area\n}",
        "bypass": "",
        "highlight": "",
        "select_trigger": "",
        "modifier_while_progressing": "",
        "on_start": "",
        "on_completion": "rouen  [patron: royals]\n  Q  \"Le Clos des Galées\": fiber_crops RGO >= 4 in lisieux; naval_supplies_guild lvl >= 2 in rouen\n  R  already a city: +5 dev instead; royals disposition +5; influence in the reward province\n  PICK  naval_morale_modifier = 0.05, navy_galley_build_cost_modifier = -0.10; royals influence in half the provinces of normandy_area\n\nNo choice event: Normandy has one quest, so its bonus and the half-area influence apply directly if the quest is true.",
        "on_persistent_completion": "",
        "on_persistent_start": "",
        "on_monthly": ""
      }
    },
    {
      "id": "senvm_fof_fra_seine_saone",
      "name": "Seine et Saône",
      "desc": "",
      "icon": "colonial_militia",
      "group": "group_1",
      "requires": [
        "senvm_fof_fra_normandy"
      ],
      "duration_days": 0,
      "final": false,
      "notes": "Areas: ile_de_france_area, picardy_area, champagne_area, burgundy_area, lyonnais_area. Ownable locations: 110. 1337 start: France owns 57, French subjects 43, others 10. Threshold 108 = +51 over start; weighted effort 59 (subject land x1, foreign land x2; target ~60).\n\nQuest system: evaluated when the mission is taken; a quest whose reward location is not owned drops out; at least half (rounded up) of the remaining quests must be true to take the mission.\nEach TRUE quest: (1) reward location goes up one rank - rural to town, town to city; never megalopolis except Paris; a city gets +5 dev instead. (2) its patron faction +5 disposition, fixed, positive only. (3) its patron faction gains influence in the reward location's province. (4) its bonus becomes an option in the choice event.\nChoice event on completion: one option per TRUE quest. The option gives its country modifier permanently AND spreads the patron faction's influence to half the provinces of that quest's area (rounded up, counting the reward province; most developed first; skips other factions' leader land), via senvm_fof_spread_apply. Disposition and influence apply only while the Fate of France situation is active and the patron faction still exists; the rank-up and the modifier always apply.\nEach TRUE quest also adds 1 to var:senvm_fof_mq_true (read by the final mission).",
      "manual_index": null,
      "blocks": {
        "visible": "",
        "enabled": "any_owned_location = {\n\tcount >= 108\n\tOR = {\n\t\tarea = area:ile_de_france_area\n\t\tarea = area:picardy_area\n\t\tarea = area:champagne_area\n\t\tarea = area:burgundy_area\n\t\tarea = area:lyonnais_area\n\t}\n}",
        "bypass": "",
        "highlight": "",
        "select_trigger": "",
        "modifier_while_progressing": "",
        "on_start": "",
        "on_completion": "paris  [patron: church]\n  Q  \"L'Université de Paris\": university in paris; scriptorium lvl >= 2 in paris\n  R  rank city -> megalopolis (Paris only); church disposition +5; influence in the reward province\n  PICK  research_speed = 0.1; church influence in half the provinces of ile_de_france_area\n\narras  [patron: republicans]\n  Q  \"Les Hautes-Lisses d'Arras\": wool RGO >= 4 in corbie; dyes RGO >= 5 in amiens\n  R  already a city: +5 dev instead; republicans disposition +5; influence in the reward province\n  PICK  num_possible_artists = 1, hire_artist_cost_modifier = -0.20; republicans influence in half the provinces of picardy_area\n\ntroyes  [patron: liberals]\n  Q  \"Les Moulins de Troyes\": paper_guild lvl >= 2 in troyes; market centre building in provins\n  R  already a city: +5 dev instead; liberals disposition +5; influence in the reward province\n  PICK  country_cabinet_efficiency = 0.05; liberals influence in half the provinces of champagne_area\n\ndijon  [patron: conservatives]\n  Q  \"La Côte de Beaune\": wine RGO >= 5 in beaune; winery lvl >= 2 in dijon\n  R  rank town -> city; conservatives disposition +5; influence in the reward province\n  PICK  diplomatic_reputation = 1; conservatives influence in half the provinces of burgundy_area\n\nlyon  [patron: liberals]\n  Q  \"La Grande Fabrique\": silk RGO >= 4 in lyon; fine_cloth_guild lvl >= 2 in lyon\n  R  rank town -> city; liberals disposition +5; influence in the reward province\n  PICK  global_merchant_power = 0.10; liberals influence in half the provinces of lyonnais_area\n\nEVENT senvm_fof_mq_seine_saone: choose 1 PICK from the TRUE quests above.",
        "on_persistent_completion": "",
        "on_persistent_start": "",
        "on_monthly": ""
      }
    },
