  "missions": [
    {
      "id": "senvm_fof_gk_destroy_pretenders",
      "name": "[Localised]",
      "desc": "",
      "icon": "angevin_heraldry",
      "group": "group_9",
      "requires": [
        "senvm_fof_bur_4"
      ],
      "duration_days": 0,
      "final": false,
      "notes": "called \"Destroy the Pretenders\" for france proper\ncalled \"Knightly Tradition\" For Burgundy\ncalled \"Rise to Power\" for everyone else\n\n\nalways\nwar score effecientcy 20% \nif not france proper:\ngives them the base game \"granted right to expand\" modifier from the base game. say that this allows them to declare war on othr appanages without going to war with france. Only grant this modifier for 80 years",
      "manual_index": null,
      "blocks": {
        "visible": "",
        "enabled": "",
        "bypass": "",
        "highlight": "",
        "select_trigger": "",
        "modifier_while_progressing": "",
        "on_start": "",
