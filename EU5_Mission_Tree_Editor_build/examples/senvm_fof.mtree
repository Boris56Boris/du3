      "requires": [
        "senvm_fof_vdu_8",
        "senvm_fof_vdu_9"
      ],
      "duration_days": 0,
      "final": true,
      "notes": "the [specilisation] should be chosen based on what type of the 3 they have the most of\nFratenite: Militante\nShould give a location modifier to every location with the town right that gives 10 monthly manpower\nset the character from merit over birth as the leader\n\nEgalite: Civil\nShould give a location modifier to every location with the town right that gives\n5 maximum control\n\nLiberte: \nShould give a location modifier to every location with the town right that gives\n10% peasent enfranchisement \nand then a global modifier giving 3 cultural capacity\n\nThey shuould all cap out at 150 locations of that type ",
      "manual_index": null,
      "blocks": {
        "visible": "",
        "enabled": "Owns at least 80% of france region\n\nverdun shouldn when they select this mission tree gain a bad estate privilege for the nobilyt called incomtent nobles that gives them 100% power and -10 happiness and -10 max tax and also -5 global max control\nit can only be removed if they have more than 100 locations with of of teh 3 urban rights\nthis privilegdge should be removed bnefore being able to take the mission",
        "bypass": "",
        "highlight": "",
        "select_trigger": "",
        "modifier_while_progressing": "",
        "on_start": "",
        "on_completion": "",
        "on_persistent_completion": "",
        "on_persistent_start": "",
        "on_monthly": ""
      }
